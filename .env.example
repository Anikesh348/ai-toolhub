APP_NAME=AI Tool Builder Backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UI_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZWFzeS1tYXJ0aW4tMjUuY2xlcmsuYWNjb3VudHMuZGV2JA
UI_NEXT_DISABLE_SWC_WORKER=1

# You can set either DB_URL or MONGO_URI. DB_URL is prioritized here.
DB_URL=mongodb+srv://admin:pass123@pricedropcluster.57zvdiu.mongodb.net/?retryWrites=true&w=majority&socketTimeoutMS=30000&connectTimeoutMS=30000&serverSelectionTimeoutMS=30000
MONGO_DB_NAME=tool_builder
MONGO_COLLECTION_PREFIX=tool_builder_v2

CODEX_WORKSPACE_HOST=/srv/codex
CODEX_WORKSPACE_CONTAINER=/workspace
CODEX_IMAGE_NAME=tool-builder-codex:latest
CODEX_COMMAND_TEMPLATE=cd {job_dir} && codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox "$(cat {prompt_file})"
CODEX_CHAT_MODELS=gpt-5-codex,gpt-5,o4-mini,o3
# Optional. If empty, the first entry in CODEX_CHAT_MODELS is used.
CODEX_DEFAULT_CHAT_MODEL=gpt-5-codex
# Optional. Leave empty if using ChatGPT Pro login with `codex --login`.
OPENAI_API_KEY=

PORT_RANGE_START=3001
PORT_RANGE_END=3999

BUILDER_CPU_LIMIT=1.0
BUILDER_MEMORY_LIMIT=512m
BUILDER_PIDS_LIMIT=100

TOOL_CPU_LIMIT=0.5
TOOL_MEMORY_LIMIT=256m
TOOL_INTERNAL_PORT=3000

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ALERT_RECIPIENT_EMAIL=

MAX_BUILD_ATTEMPTS=3
BUILD_TIMEOUT_SECONDS=900
TOOL_TEST_COMMAND=python -m pytest -q

SMOKE_TEST_PATH=/status
SMOKE_TEST_HOST=host.docker.internal
SMOKE_TEST_TIMEOUT_SECONDS=5
SMOKE_TEST_RETRIES=20
SMOKE_TEST_RETRY_INTERVAL_SECONDS=2

MONITOR_POLL_INTERVAL_SECONDS=20

# Operator mode filesystem access policy:
# - If OPERATOR_ALLOWED_PATHS is empty, Codex can access all host paths.
# - OPERATOR_DENIED_PATHS always wins and is fully blocked via mount overlays.
# - Use comma-separated absolute host paths.
OPERATOR_ALLOWED_PATHS=
OPERATOR_DENIED_PATHS=
# Optional hint paths for project discovery in operator mode.
OPERATOR_PROJECT_PATHS=/Users/anikeshthakur/Documents
OPERATOR_TIMEOUT_SECONDS=1800
# Optional GitHub HTTPS auth bridge for operator mode git push/fetch.
# Recommended: set a fine-grained PAT with repo-only permissions.
OPERATOR_GITHUB_USERNAME=x-access-token
OPERATOR_GITHUB_TOKEN=
